# Backend ortam degiskenleri
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun:
#   copy .env.example .env

# CORS: Flutter web + Firebase Hosting alan adi (virgülle). Bos veya * = tüm origin (geliştirme)
# CORS_ALLOW_ORIGINS=https://app.senin-domain.com,https://dla-xxx.web.app,http://localhost:8080

# OpenAI API anahtari (degerlendirme uclari icin; yoksa /health calisir, AI uclari 503 doner)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Ses transkripti: varsayilan whisper-1. Gostermek icin: gpt-4o-mini-transcribe
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# Sabit dil (or. tr, en) sadece gerekirse; cogu durumda bos birakin (otomatik tespit)
# OPENAI_TRANSCRIBE_LANG=

# PostgreSQL (opsiyonel - Railway deploy icin otomatik ayarlanir)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Google Play abonelik dogrulama (Android Publisher API)
# Service account JSON yolu veya ortamda ham JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# App Store makbuz dogrulama (iOS — App Store Connect > App Information > App-Specific Shared Secret)
# APPLE_SHARED_SECRET=your_shared_secret_here
